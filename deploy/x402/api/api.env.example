# COPY to /etc/madalasa/api.env as root:madalasa-api, mode 0640.
# Replace every REQUIRED placeholder and use a separate secret manager or root-only file.
# This is a configuration template, NOT a working release credential.
MA_RELEASE_PROFILE=FREE_ONLY
MA_LISTEN_ADDR=127.0.0.1
MA_LISTEN_PORT=8080
MA_PARENT_AUTH_MODE=v2_session
MA_PARENT_SESSION_TTL_SECONDS=1800
MA_ADMIN_SESSION_TTL_SECONDS=1800
# HTTPS Origin of admin UI; exact match required. Must not be http or an IP.
MA_ADMIN_ORIGIN=https://madalasa.berhampore.in
MA_PG_DB=madalasa_alarka_dev
# Development/staging only: use the exact managed PostgreSQL DNS hostname,
# never an IP address, to permit verify-full hostname validation.
MA_PG_HOST=REQUIRED_NEON_HOSTNAME
MA_PG_PORT=5432
MA_PG_USER=ap_m1_api_user
MA_PG_PASSWORD=REQUIRED_RUNTIME_DB_SECRET
MA_PG_AUTH_USER=ap_auth_issuer_user
MA_PG_AUTH_PASSWORD=REQUIRED_SEPARATE_AUTH_DB_SECRET
PGSSLMODE=verify-full
# Trust system CA chain; never sslmode=require/verify-ca/disable with remote DB.
# Confirm that /etc/ssl/certs/ca-certificates.crt exists on x402.
PGSSLROOTCERT=/etc/ssl/certs/ca-certificates.crt
MA_PG_CONNECTIONS=2
MA_PG_TIMEOUT_MS=6000
MA_PG_STATEMENT_TIMEOUT_MS=5000
MA_PG_LOCK_TIMEOUT_MS=1000
MA_GOOGLE_OIDC_AUDIENCE=REQUIRED_PARENT_GOOGLE_CLIENT_ID
MA_ADMIN_GOOGLE_OIDC_AUDIENCE=REQUIRED_ADMIN_GOOGLE_CLIENT_ID
# Separate, owner-approved Google OAuth client IDs; no fake/synthetic issuer.
# Do NOT set MA_OWNER_PAID_RELEASE_APPROVAL, MA_BILLDESK_APPROVAL or MA_PLAY_BILLING_APPROVAL.
