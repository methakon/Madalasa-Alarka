# COPY to /etc/madalasa/api.env as root:madalasa-api, mode 0640.
# Replace every REQUIRED placeholder and use a separate secret manager or root-only file.
# This is a configuration template, NOT a working release credential.
MA_RELEASE_PROFILE=FREE_ONLY
MA_LISTEN_ADDR=127.0.0.1
MA_LISTEN_PORT=8080
MA_PARENT_AUTH_MODE=v2_session
MA_PARENT_SESSION_TTL_SECONDS=1800
MA_ADMIN_SESSION_TTL_SECONDS=1800
# HTTPS Origin of admin UI; exact match required. Must not be http or an IP.
MA_ADMIN_ORIGIN=https://admin.example.invalid
MA_PG_DB=REQUIRED_DATABASE_NAME
MA_PG_HOST=127.0.0.1
MA_PG_PORT=5432
MA_PG_USER=ap_m1_api
MA_PG_PASSWORD=REQUIRED_RUNTIME_DB_SECRET
MA_PG_AUTH_USER=REQUIRED_SEPARATE_AUTH_ISSUER_ROLE
MA_PG_AUTH_PASSWORD=REQUIRED_SEPARATE_AUTH_DB_SECRET
MA_PG_CONNECTIONS=2
MA_PG_TIMEOUT_MS=6000
MA_PG_STATEMENT_TIMEOUT_MS=5000
MA_PG_LOCK_TIMEOUT_MS=1000
# OIDC issuer/audience/Google client ID must be set in the actual environment
# following backend/src/auth.h and backend/src/admin_auth.h, not invented here.
# Do NOT set MA_OWNER_PAID_RELEASE_APPROVAL, MA_BILLDESK_APPROVAL or MA_PLAY_BILLING_APPROVAL.
