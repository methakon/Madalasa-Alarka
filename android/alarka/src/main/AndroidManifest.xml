<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- INTERNET is a normal permission for authenticated HTTPS service access; no sensor grant. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Zero covert capture: no microphone, camera, or screen recording grants. -->
    <!-- Zero background monitoring or live location grants declared in synthetic prototype. -->

    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- Explicit Play designation. Location collection remains unavailable
             until Families target-audience review and OS/Play permission gates. -->
        <meta-data android:name="isMonitoringTool" android:value="child_monitoring" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
