# PLACEHOLDERS ONLY. tools/database/db init generates ignored private settings.
# Never store real credentials or child location here; .env is gitignored.
APP_ENV=development
LOG_LEVEL=info
API_LISTEN_HOST=127.0.0.1
API_LISTEN_PORT=8080
PGHOST=127.0.0.1
PGPORT=15432
PGDATABASE=madalasa_alarka_dev
PGUSER=madalasa_dev
PGPASSWORD=CHANGE_LOCALLY_NOT_A_REAL_PASSWORD
PGSSLMODE=disable
DB_HOST=127.0.0.1
DB_PORT=15432
DB_NAME=madalasa_alarka_dev
DB_USER=madalasa_dev
DB_PASSWORD=REPLACE_WITH_GENERATED_LOCAL_SECRET
DB_SSLMODE=disable
OCI_REGION=UNDECIDED
OIDC_ISSUER=https://example.invalid/oidc
OIDC_AUDIENCE=madalasa-local
FEATURE_CHILD_LOCATION=false
FEATURE_CHILD_USAGE=false
FEATURE_MEDIA_CAPTURE=false
FEATURE_MEDIA_AUDIT=false
FEATURE_ADMIN_CHILD_DETAILS=false
GPS_INBOX_DESIGN=postgres
GPS_BATCH_MAX_POINTS=500
GPS_OFFLINE_BUFFER_CAPACITY_HOURS=48
# Secret manager, mobile signing, FCM, Billing and backups require separate configuration.
